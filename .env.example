# Copy to .env (git-ignored). Placeholders and local-only dev values; never put real secrets here.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (compose builds DATABASE_URL from these; set DATABASE_URL yourself outside compose)
POSTGRES_DB=eqp4l
POSTGRES_USER=eqp4l
POSTGRES_PASSWORD=eqp4l_local_dev
# DATABASE_URL=postgres://eqp4l:eqp4l_local_dev@127.0.0.1:5432/eqp4l

# Cookies / HTTPS (all default to strict when DJANGO_DEBUG=False)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_PROXY_SSL_HEADER_ENABLED=True

# Error monitoring: Sentry starts only when a DSN is set
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Local-only dev seed passwords (used by the seed command once models exist; one-time, forced change on first login)
DEV_SA_0001_PASSWORD=local-dev-super-admin-1
DEV_WAREHOUSE_ADMIN_PASSWORD=local-dev-warehouse-admin-1
DEV_BRANCH_ADMIN_PASSWORD=local-dev-branch-admin-1
DEV_FRONT_STAFF_PASSWORD=local-dev-front-staff-1
