# eqp4l-backend environment variables.
# Copy to .env for local use and fill in real values there. .env is git-ignored.
# Every value below is a dummy placeholder. Never put a real secret in this file.

# Django
DJANGO_SECRET_KEY=change-me-local-only-placeholder
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Accra

# Database (PostgreSQL). Used by Docker Compose and Django.
POSTGRES_DB=eqp4l
POSTGRES_USER=eqp4l
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://eqp4l:change-me@localhost:5432/eqp4l

# CORS and CSRF: only the frontend's own origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Cookies (true on staging and production, which are HTTPS only)
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Error monitoring (Sentry). Leave the DSN empty locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
