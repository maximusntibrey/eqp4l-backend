# eqp4l-backend environment variables (LOCAL DEVELOPMENT ONLY).
#   Windows PowerShell:  copy .env.example .env      (scripts/dev.ps1 does this for you)
#   Git Bash / Linux:    cp .env.example .env
# .env is git-ignored: edit values there, never here. Every value below is a dummy
# placeholder. Never put a real secret in this file.
# Required by the settings (no defaults): DJANGO_SECRET_KEY and DATABASE_URL.
# Docker Compose also runs without a .env, using the same local-only defaults.

# --- Django ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-local-only-placeholder
DJANGO_DEBUG=false
# LOCAL ONLY. true lets the session/CSRF cookies work over plain http://localhost and adds
# the Vite origins (localhost:5173, 127.0.0.1:5173) to CSRF_TRUSTED_ORIGINS. Staging and
# production must NOT set it: with it unset, insecure cookies refuse to start.
DJANGO_LOCAL=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Accra

# --- Ports on your machine (loopback only) ----------------------------------------------
# PostgreSQL is published on 5433 so it does not clash with a Postgres already installed
# on Windows (5432). Change either port if it is taken, and keep DATABASE_URL in step.
APP_PORT=8000
POSTGRES_PORT=5433

# --- Database (PostgreSQL) ----------------------------------------------------------------
# Compose reads POSTGRES_* to create the database container and builds the app container's
# DATABASE_URL itself (host "db", port 5432 inside the Compose network). DATABASE_URL below
# is for running Django on the host (venv, tests, scripts/check.sh) against the Compose
# database. Keep POSTGRES_PASSWORD URL-safe (letters and digits) because it goes in a URL.
# Use 127.0.0.1, not localhost: on Windows "localhost" can try IPv6 first and hang.
POSTGRES_DB=eqp4l
POSTGRES_USER=eqp4l
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=127.0.0.1
DATABASE_URL=postgres://eqp4l:changeme@127.0.0.1:5433/eqp4l

# --- Frontend origins ---------------------------------------------------------------------
# Local frontend (npm run dev, http://localhost:5173) calls the API through the Vite proxy
# (/api -> http://127.0.0.1:8000), so the browser sees ONE origin and CORS is not needed.
# CSRF trusted origins are only the frontend's own origins. CORS stays as a fallback for a
# frontend that calls the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cookies ------------------------------------------------------------------------------
# false is accepted ONLY with DJANGO_LOCAL=true (or DJANGO_DEBUG=true). Staging and
# production are HTTPS only: leave both unset (secure by default) or true.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# --- Container start-up (docker/entrypoint.sh) ---------------------------------------------
# Apply migrations when the app container starts (1 = yes).
DJANGO_MIGRATE_ON_START=1
# 1 = run `python manage.py seed_dev` on start IF that command exists. It arrives with
# B2.5 (SA/BA/WA/FS/Cashier dev logins). Until then this does nothing. LOCAL ONLY.
DJANGO_SEED_DEV=1
# LOCAL ONLY. Passwords the B2.5 seed will give the dev logins. Replace the placeholders
# in your own .env; never reuse a real password, never use these outside this machine.
# Not read by anything until B2.5.
DEV_SEED_PASSWORD_ADMIN=change-me-local-only
DEV_SEED_PASSWORD_USERS=change-me-local-only

# --- Error monitoring (Sentry) --------------------------------------------------------------
# Leave the DSN empty locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Release id (for example the git tag or commit) so new errors can be tied to a deploy.
SENTRY_RELEASE=
