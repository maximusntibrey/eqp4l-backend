DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-staging-secret-from-secret-store
DJANGO_ALLOWED_HOSTS=staging.example.invalid
CORS_ALLOWED_ORIGINS=https://staging.example.invalid
CSRF_TRUSTED_ORIGINS=https://staging.example.invalid
DATABASE_URL=postgres://eqp4l:replace-me@db:5432/eqp4l
POSTGRES_DB=eqp4l
POSTGRES_USER=eqp4l
POSTGRES_PASSWORD=replace-me
SECURE_PROXY_SSL_HEADER_ENABLED=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
